    "ruleCards": [
      {
        "title": "Source",
        "content": "Some of Ciri's cards are SOURCE cards (Source icon in the banner). Their effects are marked SOURCE N. When resolving one, count the SOURCE cards in your discard pile and resolve the effect with the highest N that is equal to or less than that count; you may not choose the lower one. If you have fewer than the lower N, resolve neither. With 7 or more SOURCE cards in your discard pile, effects on your cards cannot be canceled."
      },
      {
        "title": "Ongoing schemes",
        "content": "After resolving an ONGOING scheme, leave it face up instead of discarding it. Check its discard condition only at the end of your turn. You can have only one ongoing scheme at a time: playing another discards the current one."
      }
    ]
