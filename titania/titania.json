    "ruleCards": [
      {
        "title": "Glamour deck",
        "content": "Shuffle the 6 glamours face down beside your deck. \"Discard your glamour\" puts the face-up one in your glamour discard pile; \"a discarded glamour\" comes from there."
      },
      {
        "title": "Glamour of Greed",
        "content": "At the end of your turn, you may draw 1 card."
      },
      {
        "title": "Glamour of Jealousy",
        "content": "When Titania or Oberon are attacked, before playing a card, they may swap spaces. If they do, your other fighter is now the defender."
      },
      {
        "title": "Glamour of Love",
        "content": "When you maneuver, you may move an opposing fighter 1 space before moving your fighters."
      },
      {
        "title": "Glamour of Sleep",
        "content": "Your fighters do not take damage other than combat damage."
      },
      {
        "title": "Glamour of Invisibility",
        "content": "Your fighters may move through opposing fighters."
      },
      {
        "title": "Glamour of Rhyme",
        "content": "After you play a scheme, gain 1 action."
      }
    ]
