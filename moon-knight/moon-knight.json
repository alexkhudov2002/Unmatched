    "ruleCards": [
      {
        "title": "Identities",
        "content": "Moon Knight → Khonshu → Mr. Knight → Moon Knight. All three: 16 health, MOVE 3, melee; health carries over. Change at the end of each of your turns (I'm Not Real lets you change after combat too)."
      },
      {
        "title": "Khonshu",
        "content": "Khonshu adds +2 to the value of his attack cards. He does not take damage from effects other than combat damage.\nAt the end of your turn, change to your next identity (Mr. Knight)."
      },
      {
        "title": "Mr. Knight",
        "content": "Mr. Knight adds +1 to all his defense values.\nAt the end of your turn, change to your next identity (Moon Knight)."
      }
    ]
