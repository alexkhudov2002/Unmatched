    "ruleCards": [
      {
        "title": "Summon a Wolf",
        "content": "You have 2 Wolf tokens (1 health, melee, move 3). To summon a Wolf, if any of your Wolves are off the board (including defeated ones), place one in an empty space as the effect says. If both are on the board, choose one and place it there instead. The +3 of Heart of the Forest only counts the Leshen's own attacks, not the Wolves'."
      },
      {
        "title": "Ongoing schemes",
        "content": "After resolving an ONGOING scheme, leave it face up instead of discarding it. Check its discard condition only at the end of your turn. You can have only one ongoing scheme at a time: playing another discards the current one."
      }
    ]
