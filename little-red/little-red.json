    "ruleCards": [
      {
        "title": "Basket symbols",
        "content": "Each card shows its item under the fighter name: ● pelt (round), ◆ knife (diamond), ▲ wolfsbane (triangle), ★ any one of the three.\nThe item in your basket is the one on the card on top of your discard pile. An effect marked ●, ◆ or ▲ only resolves if it matches that item; unmarked text always resolves."
      },
      {
        "title": "Little Red's Basket",
        "content": "At the start of the game LITTLE RED'S BASKET goes on top of your discard pile (not part of your deck or hand). It is not in this export: until you discard a card, your basket holds any one item (★), as the Basket card does."
      }
    ]
